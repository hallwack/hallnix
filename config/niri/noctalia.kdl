layout {

    focus-ring {
        active-color   "#85cfff"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#85cfff"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#85cfff"
        inactive-color "#004c6c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#85cfff80"
    }
}

recent-windows {
    highlight {
        active-color "#85cfff"
        urgent-color "#ffb4ab"
    }
}
