shell-integration = zsh

clipboard-read = allow
clipboard-write = allow

theme = GruvboxDarkHard
background-opacity = 0.9

background = #1d2021
foreground = #ebdbb2

selection-background = #665c54
selection-foreground = #ebdbb2

cursor-color = #ebdbb2
cursor-text = #1d2021
cursor-opacity = 0.45

window-theme = ghostty
window-height = 36
window-width = 180
window-padding-x = 12
window-padding-y = 12
adjust-cell-height = 14%
adjust-cell-width = 5%

window-titlebar-background = #1d2021
window-titlebar-foreground = #d79921

palette = 0=#1d2021
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

font-size = 11
font-family = GeistMono Nerd Font
font-style = Semibold

keybind = ctrl+shift+j=scroll_page_lines:8
keybind = ctrl+shift+k=scroll_page_lines:-8

keybind = ctrl+alt+left_bracket=goto_split:previous
keybind = ctrl+alt+right_bracket=goto_split:next

keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

keybind = ctrl+shift+alt+h=resize_split:left,10
keybind = ctrl+shift+alt+j=resize_split:down,10
keybind = ctrl+shift+alt+k=resize_split:up,10
keybind = ctrl+shift+alt+l=resize_split:right,10

keybind = super+q=close_window
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+alt+w=close_tab
